# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
ENCRYPTION_KEY=your-encryption-key-must-be-at-least-32-characters-long
META_VERIFY_TOKEN=your-meta-webhook-verify-token
META_APP_SECRET=your-meta-app-secret
META_APP_ID=your-meta-app-id
META_INITIAL_ACCESS_TOKEN=your-meta-initial-access-token
CRON_SECRET=your-cron-secret-key
DASHBOARD_PASSWORD=your-secure-password

# Operator / public contact info (shown on /privacy, /terms, /data-deletion, and the landing page footer)
# This is the email end-users will see and contact for support, data deletion requests, etc.
NEXT_PUBLIC_CONTACT_EMAIL=your-contact-email@example.com
OPERATOR_NAME=Your Name or Organization
NEXT_PUBLIC_SITE_URL = netlify or vercel url
