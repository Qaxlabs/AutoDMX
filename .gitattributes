# Auto-detect text files, ensure consistent line endings
* text=auto eol=lf

# Force LF for source code
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf

# Binary files (keep as-is)
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
